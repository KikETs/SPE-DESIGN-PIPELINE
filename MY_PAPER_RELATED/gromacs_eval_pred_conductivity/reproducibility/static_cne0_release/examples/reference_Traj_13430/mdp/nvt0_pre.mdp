integrator               = md
dt                       = 0.000500
cutoff-scheme            = Verlet
nstlist                  = 20
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
rvdw                     = 1.0
DispCorr                 = EnerPres
fourierspacing           = 0.14
pbc                      = xyz
constraints              = none
constraint-algorithm     = lincs
lincs_iter               = 3
lincs_order              = 8
lincs-warnangle          = 30
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 5.00
nstxout-compressed       = 500
nstvout                  = 0
nstenergy                = 10000
gen-vel                  = yes
nsteps                   = 10000
ref-t                    = 50.0
pcoupl                   = no
gen-temp                 = 50.0
gen-seed                 = -1
define                   = -DPOSRES
annealing                = single
annealing-npoints        = 2
annealing-time           = 0 5.0
annealing-temp           = 50.0 100.0
