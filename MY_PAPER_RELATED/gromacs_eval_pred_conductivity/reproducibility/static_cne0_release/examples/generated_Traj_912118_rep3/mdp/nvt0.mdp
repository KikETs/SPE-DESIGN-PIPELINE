integrator               = md
dt                       = 0.001000
cutoff-scheme            = Verlet
nstlist                  = 20
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
rvdw                     = 1.0
DispCorr                 = EnerPres
fourierspacing           = 0.14
pbc                      = xyz
constraints              = h-bonds
constraint-algorithm     = lincs
lincs_iter               = 4
lincs_order              = 12
lincs-warnangle          = 20
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 5.00
nstxout-compressed       = 500
nstvout                  = 0
nstenergy                = 10000
gen-vel                  = no
nsteps                   = 100000
ref-t                    = 100.0
pcoupl                   = no
define                   = -DPOSRES
annealing                = single
annealing-npoints        = 2
annealing-time           = 0 100.0
annealing-temp           = 100.0 353.0
